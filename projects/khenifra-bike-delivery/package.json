{
  "name": "khenifra-bike-delivery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "setup:appwrite": "node scripts/setup-appwrite.mjs",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:sync": "npx cap sync",
    "mobile:android": "npx cap sync android && npx cap open android",
    "mobile:ios": "npx cap sync ios && npx cap open ios",
    "mobile:configure": "node scripts/configure-native.mjs",
    "mobile:setup": "npm install && npm run mobile:add:android && npm run mobile:add:ios && npm run mobile:configure && npm run mobile:sync",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "appwrite": "28.1.0",
    "node-appwrite": "29.0.0",
    "lucide-react": "1.52.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/geolocation": "8.2.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/status-bar": "8.0.4",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "@capacitor/cli": "8.5.2"
  }
}
