# Appwrite Cloud (browser-safe configuration)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6abc6d6f002d62e54e76

# Khenifra Delivery TablesDB identifiers
NEXT_PUBLIC_APPWRITE_DATABASE_ID=khenifra_delivery
NEXT_PUBLIC_APPWRITE_DELIVERIES_TABLE_ID=deliveries
NEXT_PUBLIC_APPWRITE_PROFILES_TABLE_ID=profiles
